# Copy to .env (same folder) and fill in. .env is read by main.py and never committed.
# LLM from the MB Nexus portal (Azure OpenAI format when LLM_FAST_API_VERSION is set).
LLM_FAST_PROVIDER=nexus
LLM_FAST_MODEL=gpt-4o
LLM_FAST_API_URL=https://genai-nexus.int.api.corpinter.net
LLM_FAST_API_KEY=...
LLM_FAST_API_VERSION=2023-12-01-preview

