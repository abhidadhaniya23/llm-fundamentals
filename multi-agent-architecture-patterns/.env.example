# Copy to .env (same folder) and fill in. .env is read by every lab and by main.py, and never committed.

# ===== Labs (labs/*.py) =====
# Which model provider the labs use: nexus (default) or anthropic.
LLM_PROVIDER=nexus

# --- nexus ---
NEXUS_BASE_URL=https://nexus.example.internal/v1
NEXUS_API_KEY=...
NEXUS_MODEL=MODEL-NAME
# Optional. Azure-style gateway API version (default 2024-10-21); set empty for a plain /chat/completions endpoint.
# NEXUS_API_VERSION=2024-10-21

# --- anthropic ---
ANTHROPIC_API_KEY=...
# Optional. Defaults to claude-opus-5-5.
# ANTHROPIC_MODEL=claude-opus-5-5

# ===== DAS chatbot (main.py) =====
# LLM from the MB Nexus portal (Azure OpenAI format when LLM_FAST_API_VERSION is set).
LLM_FAST_PROVIDER=nexus
LLM_FAST_MODEL=gpt-4o
LLM_FAST_API_URL=https://genai-nexus.int.api.corpinter.net
LLM_FAST_API_KEY=...
LLM_FAST_API_VERSION=2023-12-01-preview

# Optional: scenario date ("yesterday" = Priya's upload batch on 2026-10-29)
# DAS_TODAY=2026-10-30
